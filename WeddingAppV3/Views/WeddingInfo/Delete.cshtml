@model WeddingInfo
@{
    ViewData["Title"] = "Delete text block";
}

<h1 class="event-title">Delete Text Block</h1>

<div class="alert alert-warning">Are you sure you want to delete this text block? This cannot be undone.</div>

<h2 class="h4">@Model.Heading</h2>
<p>@Model.Content</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
