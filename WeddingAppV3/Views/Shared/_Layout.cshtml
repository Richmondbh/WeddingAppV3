@*
    Shared layout used by every view: header with the navigation menu,
    the main content area and the footer.
*@

@{
    string currentController = ViewContext.RouteData.Values["controller"] as string;
    string currentAction = ViewContext.RouteData.Values["action"] as string;

    // Decides which menu item is highlighted for the current request.
    bool IsActive(string menuItem)
    {
        switch (menuItem)
        {
            case "Home":
                return currentController == "Home" && currentAction == "Index";
            case "Gallery":
                return currentController == "Home" && currentAction == "Gallery";
            case "Event":
                return currentController == "Event" && currentAction == "Index";
            case "Register":
                return currentController == "Guest" && currentAction == "Create";
            case "Guests":
                return currentController == "Guest" && currentAction != "Create";
            case "Admin":
                return currentController == "Admin"
                    || currentController == "WeddingInfo"
                    || (currentController == "Event" && currentAction != "Index");
            default:
                return false;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &ndash; Richmond &amp; Keziah (FLOR27)</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="site-mark" asp-controller="Home" asp-action="Index">Richmond &amp; Keziah (FLOR27)</a>

            <nav aria-label="Main menu">
                <ul class="site-nav">
                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="@(IsActive("Home") ? "active" : null)">Home</a>
                    </li>
                    <li>
                        <a asp-controller="Event" asp-action="Index"
                           class="@(IsActive("Event") ? "active" : null)">Event</a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Gallery"
                           class="@(IsActive("Gallery") ? "active" : null)">Gallery</a>
                    </li>
                    <li>
                        <a asp-controller="Guest" asp-action="Create"
                           class="@(IsActive("Register") ? "active" : null)">Register Guest</a>
                    </li>
                    <li>
                        <a asp-controller="Guest" asp-action="Index"
                           class="@(IsActive("Guests") ? "active" : null)">List Guests</a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Index"
                           class="@(IsActive("Admin") ? "active" : null)">Admin</a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <h2 class="footer-heading">The celebration</h2>
                    <p>
                        14 July 2027 at 17:00<br />
                        Hope Wedding Hall<br />
                        Östersund, Sweden
                    </p>
                </div>

                <div>
                    <h2 class="footer-heading">Questions</h2>
                    <p>
                        <a href="mailto:hej@@richkez.se">hej@@richkez.se</a><br />
                        +46 76 931 68 71
                    </p>
                </div>

                <div>
                    <h2 class="footer-heading">Pages</h2>
                    <ul class="footer-links">
                        <li><a asp-controller="Event" asp-action="Index">Event details</a></li>
                        <li><a asp-controller="Home" asp-action="Gallery">Photo gallery</a></li>
                        <li><a asp-controller="Guest" asp-action="Create">Register as a guest</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-base">
                <p>&copy; 2026 Richmond &amp; Keziah (FLOR27)</p>
                <p>
                    Developed by
                    <a href="https://rhbdigital.se" target="_blank" rel="noopener">RHB Digital Solutions</a>
                </p>
            </div>
        </div>
    </footer>
</body>
</html>
