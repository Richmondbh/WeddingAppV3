@model DashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<h1 class="event-title">Admin Dashboard</h1>

<h2 class="h4">RSVP statistics</h2>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.TotalGuests</span>
            <span class="stat-label">Registered guests</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.AttendingCount</span>
            <span class="stat-label">Attending</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.NotAttendingCount</span>
            <span class="stat-label">Not attending</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.TotalAttendants</span>
            <span class="stat-label">Total attendants</span>
        </div>
    </div>
</div>

<p>Guests who have not answered yet: <strong>@Model.NoResponseCount</strong></p>

<h2 class="h4 mt-4">Manage</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="h5">Guests</h3>
                <p>Search, filter, edit and delete guests and their RSVPs.</p>
                <a asp-controller="Guest" asp-action="Index" class="btn btn-primary">Manage guests</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="h5">Events (@Model.EventCount)</h3>
                <p>Ceremony, dinner, party and other parts of the day.</p>
                <a asp-controller="Event" asp-action="Manage" class="btn btn-primary">Manage events</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="h5">Wedding information (@Model.WeddingInfoCount)</h3>
                <p>Welcome message, venue and contact text on the home page.</p>
                <a asp-controller="WeddingInfo" asp-action="Index" class="btn btn-primary">Manage content</a>
            </div>
        </div>
    </div>
</div>

<h2 class="h4">Latest guest messages</h2>

@if (Model.RecentMessages.Count == 0)
{
    <p>No messages yet.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (Guest guest in Model.RecentMessages)
        {
            <li class="list-group-item">
                <strong>@guest.Name</strong>
                <p class="mb-0">@guest.Message</p>
            </li>
        }
    </ul>
}
