@model List<WeddingInfo>
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="event-title">We Are Getting Married!</h1>
    <p>We are delighted to invite you to celebrate this special occasion with us.</p>
</div>

@* The text blocks below will come from the database and are edited under Admin. *@
<div class="row justify-content-center">
    <div class="col-md-8">
        @foreach (WeddingInfo info in Model)
        {
            <section class="info-block">
                <h2 class="h4">@info.Heading</h2>
                <p>@info.Content</p>
            </section>
        }
    </div>
</div>

<div class="text-center mt-4">
    <a asp-controller="Event" asp-action="Index" class="btn btn-primary">See the programme</a>
    <a asp-controller="Guest" asp-action="Create" class="btn btn-outline-primary">Register as a guest</a>
</div>
