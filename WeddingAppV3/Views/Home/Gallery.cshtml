@{
    ViewData["Title"] = "Gallery";
}

<h1 class="event-title text-center">Photo Gallery</h1>
<p class="text-center">A few of our favourite moments on the way to the big day.</p>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <img src="~/images/proposal.jpg" class="card-img-top gallery-image"
                 alt="The couple on the evening of the proposal" />
            <div class="card-body"><p class="card-text text-center">The proposal</p></div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <img src="~/images/venue.jpg" class="card-img-top gallery-image"
                 alt="The garden outside the wedding hall" />
            <div class="card-body"><p class="card-text text-center">The venue</p></div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <img src="~/images/wedding.jpg" class="card-img-top gallery-image"
                 alt="Friends and family at the party" />
            <div class="card-body"><p class="card-text text-center">The wedding party</p></div>
        </div>
    </div>
</div>
