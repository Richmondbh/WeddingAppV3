## .gitignore for WeddingAppV3 (ASP.NET Core MVC, .NET 9, Visual Studio)

# Visual Studio cache and user-specific settings
.vs/
*.user
*.suo
*.rsuser
*.userprefs

# Build output (recreated every time you build)
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
*.log

# NuGet packages (downloaded again automatically on restore)
*.nupkg
*.snupkg
**/[Pp]ackages/*

# Publish output and publish profiles (can contain connection strings)
publish/
*.pubxml
*.publishproj
*.azurePubxml
*.publishsettings

# Generated by Identity scaffolding
ScaffoldingReadMe.txt

# Test and code coverage results
[Tt]est[Rr]esult*/
*.coverage
coverage*.json
coverage*.xml

# SQLite database files (the database is recreated from the migrations and SeedData)
*.db
*.db-shm
*.db-wal

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Node (only if npm tools are ever used)
node_modules/